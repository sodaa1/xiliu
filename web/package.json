{
  "name": "xiliu-web",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node ../docs/web/scripts/build-intro-showcase.mjs build --app",
    "build:demo": "tsc -b && vite build --config vite.demo.config.ts --mode demo",
    "preview:demo": "vite preview --config vite.demo.config.ts --mode demo --host 127.0.0.1 --port 5184",
    "test": "vitest",
    "lint": "eslint .",
    "format": "prettier --write src *.ts *.js *.json index.html",
    "format:check": "prettier --check src *.ts *.js *.json index.html"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "gh-pages": "6.1.1"
  }
}
