{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local workbench window controls only",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": ["core:event:default", "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-close"]
}
