{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "息流",
  "version": "0.4.6",
  "identifier": "io.xiliu.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        "main",
        "companion"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/xiliu-service"
    ],
    "resources": {
      "binaries/_internal/": "_internal/"
    },
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
