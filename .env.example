XILIU_PROVIDER=openai
XILIU_API_KEY=
TAVILY_API_KEY=
XILIU_MODEL=
# Optional comma-separated fallback order:
XILIU_MODELS=
XILIU_BASE_URL=
XILIU_TEMPERATURE=0
XILIU_TIMEOUT_SECONDS=60
XILIU_ANALYSIS_TIMEOUT_SECONDS=30
XILIU_ANALYSIS_MAX_CHARS=8000
# Planner Memory compression: trigger at 80% of a 64k context and keep newest 8k tokens.
XILIU_CONTEXT_WINDOW_TOKENS=64000
XILIU_COMPRESSION_TRIGGER_RATIO=0.8
XILIU_COMPRESSION_KEEP_TOKENS=8000
XILIU_DATA_DIR=.xiliu
# Harness persistence modes: light/strict/off and full/summary/off.
XILIU_CHECKPOINT_MODE=light
XILIU_TRACE_MODE=full
# Optional unique ID for a single run; omit to generate one automatically.
# XILIU_TRACE_ID=my-run
