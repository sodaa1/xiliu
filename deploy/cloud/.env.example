XILIU_CLOUD_ORIGIN=https://app.example.com
XILIU_CLOUD_DOMAIN=app.example.com
# Generate once; keep it separately backed up. Never commit the actual value.
XILIU_CLOUD_MASTER_KEY=
XILIU_CLOUD_LOCAL_HTTP=0
XILIU_CLOUD_SIGNUP=1
XILIU_CLOUD_MAX_USERS=100
# Optional operator-funded trial. Both key and model must be set to enable it.
XILIU_CLOUD_TRIAL_API_KEY=
XILIU_CLOUD_TRIAL_MODEL=
XILIU_CLOUD_TRIAL_BASE_URL=https://api.openai.com/v1
XILIU_CLOUD_TRIAL_DAILY_LIMIT=100
